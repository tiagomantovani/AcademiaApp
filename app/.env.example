# Copie para .env e preencha com seu Supabase (mesmo do server/.env)
# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...sua_anon_key
# Opcional: URL do servidor catraca para QR validar via HTTP
EXPO_PUBLIC_CATRACA_URL=http://192.168.3.200:3001
